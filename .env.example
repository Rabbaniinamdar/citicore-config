# =============================================================================
# CitiCore Configuration Repository — Environment Variable Reference
# =============================================================================
# This file documents every environment variable referenced by the YAML
# configuration in this repository. It is a REFERENCE — it is NOT loaded by
# Spring Boot and contains NO real secrets.
#
# Real values are injected by the deployment environment:
#   - Local:        .env.local (gitignored)
#   - Test:         GitHub Actions secrets / Testcontainers
#   - Staging/Prod: AWS Secrets Manager + IRSA (K8s env vars)
# =============================================================================

# --- Database ---------------------------------------------------------------
DB_USERNAME
DB_PASSWORD
DB_NAME                      # default: citicore

# --- Kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS
MSK_STAGING_BOOTSTRAP_SERVERS
MSK_PROD_BOOTSTRAP_SERVERS

# --- Redis ------------------------------------------------------------------
REDIS_HOST
REDIS_PORT
ELASTICACHE_STAGING_ENDPOINT
ELASTICACHE_PROD_ENDPOINT

# --- Object Storage ---------------------------------------------------------
AWS_REGION
AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY
MINIO_ROOT_USER
MINIO_ROOT_PASSWORD
S3_BUCKET

# --- Email ------------------------------------------------------------------
MAIL_USERNAME
MAIL_PASSWORD
SES_STAGING_USERNAME
SES_STAGING_PASSWORD
SES_PROD_USERNAME
SES_PROD_PASSWORD

# --- Security ---------------------------------------------------------------
JWT_SECRET
JWK_SET_URI

# --- Config Server / Git ----------------------------------------------------
CONFIG_GIT_URI
CONFIG_GIT_USERNAME
CONFIG_GIT_TOKEN
CONFIG_GIT_LABEL              # default: main
CONFIG_SERVER_URI             # default: http://localhost:8888

# --- Service discovery ------------------------------------------------------
EUREKA_SERVER_URL             # default: http://eureka-server:8761/eureka

# --- Service-specific endpoints ---------------------------------------------
AUTH_DB_HOST                  # default: mysql
USER_DB_HOST                  # default: mysql
TRANSACTION_DB_HOST           # default: mysql
RDS_STAGING_ENDPOINT
RDS_PROD_ENDPOINT